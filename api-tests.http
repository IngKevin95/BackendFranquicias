@baseUrl = http://localhost:8080/api/v1

### ==========================================
### 0. AUTENTICACIÓN (NUEVO)
### ==========================================

### Obtener Token JWT
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

### Extraer Token manualmente o copiándolo
@token = PON_AQUI_EL_TOKEN_DE_ARRIBA

### ==========================================
### INSTRUCCIONES: Reemplaza manualmente los IDs 
### o ejecuta el script test.ps1 / test.sh
### ==========================================
@fId = PON_AQUI_EL_ID_DE_FRANQUICIA
@sId = PON_AQUI_EL_ID_DE_SUCURSAL
@pId = PON_AQUI_EL_ID_DE_PRODUCTO

### ==========================================
### 1. FRANQUICIAS
### ==========================================

### Crear Franquicia
POST {{baseUrl}}/franquicias
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "McDonalds"
}

### Renombrar Franquicia
PATCH {{baseUrl}}/franquicias/{{fId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "McDonalds Global"
}


### ==========================================
### 2. SUCURSALES
### ==========================================

### Agregar Sucursal (Sede Norte)
POST {{baseUrl}}/franquicias/{{fId}}/sucursales
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Sede Norte"
}

### Renombrar Sucursal
PATCH {{baseUrl}}/franquicias/{{fId}}/sucursales/{{sId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Sede Norte Actualizada"
}


### ==========================================
### 3. PRODUCTOS
### ==========================================

### Agregar Producto A (Hamburguesa)
POST {{baseUrl}}/franquicias/{{fId}}/sucursales/{{sId}}/productos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Hamburguesa Sencilla"
}

### Renombrar Producto A
PATCH {{baseUrl}}/franquicias/{{fId}}/sucursales/{{sId}}/productos/{{pId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Hamburguesa Doble"
}


### ==========================================
### 4. KARDEX Y MANEJO DE INVENTARIO
### ==========================================

### Kardex: Modificar Stock (ENTRADA con Idempotencia)
PATCH {{baseUrl}}/franquicias/{{fId}}/sucursales/{{sId}}/productos/{{pId}}/stock
Content-Type: application/json
Authorization: Bearer {{token}}
Idempotency-Key: 11111111-2222-3333-4444-555555555555

{
  "tipo": "ENTRADA",
  "cantidad": 20
}

### Kardex: Modificar Stock (SALIDA)
PATCH {{baseUrl}}/franquicias/{{fId}}/sucursales/{{sId}}/productos/{{pId}}/stock
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tipo": "SALIDA",
  "cantidad": 5
}

### Kardex: ERROR (Debe dar 400 Bad Request por stock insuficiente)
PATCH {{baseUrl}}/franquicias/{{fId}}/sucursales/{{sId}}/productos/{{pId}}/stock
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tipo": "SALIDA",
  "cantidad": 9999
}


### ==========================================
### 5. MAX STOCK Y CACHÉ (REDIS)
### ==========================================

### Consulta Paginada de Max Stock
GET {{baseUrl}}/franquicias/{{fId}}/productos/max-stock?limit=10&offset=0
Authorization: Bearer {{token}}


### ==========================================
### 6. SEGURIDAD Y SEMÁNTICA REST (409 CONFLICT)
### ==========================================

### Test Error de Relación (409 Conflict)
@fakeFId = 11111111-1111-1111-1111-111111111111
PATCH {{baseUrl}}/franquicias/{{fakeFId}}/sucursales/{{sId}}/productos/{{pId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Producto Hackeado"
}


### ==========================================
### 7. ELIMINACIÓN
### ==========================================

### Eliminar Producto
DELETE {{baseUrl}}/franquicias/{{fId}}/sucursales/{{sId}}/productos/{{pId}}
Authorization: Bearer {{token}}


### ==========================================
### 8. USUARIOS (ADMIN ONLY)
### ==========================================

### Crear usuario WRITE (requiere token ADMIN)
POST {{baseUrl}}/usuarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "operador1",
  "password": "operador123",
  "email": "operador1@franquicias.com",
  "role": "WRITE"
}
